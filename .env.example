# Copy this file to .env for explicit local commands only.
AWS_REGION=eu-west-1
REPORT_TIMEZONE=Europe/Madrid
LOG_LEVEL=INFO
# Local development only. Never commit a populated .env file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
